{
  "name": "ja-recruiting-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --filter @ja/workbench-console dev",
    "dev:site": "vite --config sites.vite.config.js",
    "build": "pnpm -r --if-present build",
    "build:site": "vite build --config sites.vite.config.js",
    "test": "pnpm -r --if-present test && node --test scripts/*.test.mjs",
    "test:site": "pnpm build:site && node --test scripts/site-worker.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "audit": "pnpm audit --prod",
    "privacy:check": "node scripts/privacy-check.mjs",
    "check": "pnpm privacy:check && pnpm typecheck && pnpm test && pnpm build && pnpm test:site"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@jastudioconsulting/recruitment-skills": "github:JaStudioConsulting/recruitment-skills#9e9a116c2ae3f56b9aef1abff8476698da793fbb",
    "@openai/sites-vite-plugin": "0.2.0",
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
