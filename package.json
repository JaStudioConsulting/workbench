{
  "name": "ja-recruiting-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @ja/workbench-console dev",
    "start:local": "pnpm --prefix apps/gateway start:local",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test && node --test scripts/privacy-check.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "audit": "pnpm audit --prod",
    "privacy:check": "node scripts/privacy-check.mjs",
    "check": "pnpm privacy:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.0.2",
    "supabase": "^3.1.0",
    "vite": "8.0.13"
  }
}
