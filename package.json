{
  "name": "ja-recruiting-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --filter @ja/workbench-console dev",
    "dev:sandbox": "VITE_SANDBOX_MODE=true pnpm --filter @ja/workbench-console dev",
    "build:sandbox": "pnpm --filter @ja/workbench-console build:sandbox",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test && node --test scripts/*.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "audit": "pnpm audit --prod",
    "privacy:check": "node scripts/privacy-check.mjs",
    "check": "pnpm privacy:check && pnpm typecheck && pnpm test && pnpm build"
  }
}
